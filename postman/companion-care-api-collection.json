              "raw": "{\n    \"email_notifications\": true\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/user/settings",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "user",
                "settings"
              ]
            },
            "description": "현재 로그인한 사용자의 설정 정보를 업데이트합니다."
          },
          "response": []
        },
        {
          "name": "사용자 설정 업데이트 (인증 없음)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email_notifications\": true\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/user/settings",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
